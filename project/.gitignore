# Data — the source spreadsheet shouldn't live in git
data/*
!data/.gitkeep

# Generated results — regenerate via run_pipeline.py
results/*
!results/.gitkeep

# Jupyter
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Editors / OS
.vscode/
.idea/
.DS_Store

# Torch / TF checkpoints if ever dumped to disk
*.pt
*.pth
*.h5
*.keras
